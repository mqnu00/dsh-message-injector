{
  "name": "dsh-message-injector",
  "version": "0.2.0",
  "description": "dsh 插件：预设常用消息注入内容组合（任意文本/技能调用），每条消息自动注入到输入框首行",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bundle.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.0 <0.3.0-0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": ">=0.2.0-rc.0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.0 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "install:plugin": "dsh plugin --profile web add \"$PWD\"",
    "uninstall:plugin": "dsh plugin --profile web remove dsh-message-injector"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
